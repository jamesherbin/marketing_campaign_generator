# Local PostgreSQL bootstrap password. This account is disabled after creating
# the migration/runtime/operator roles; it is never used by the application.
LOCAL_POSTGRES_BOOTSTRAP_PASSWORD=replace-with-a-unique-bootstrap-password

# Keep all three database roles distinct. The API must use the runtime role;
# management commands must use the operator role. Never use bootstrap/migrator
# credentials as application credentials.
LOCAL_CAMPAIGN_MIGRATOR_PASSWORD=replace-with-a-unique-migrator-password
LOCAL_CAMPAIGN_RUNTIME_PASSWORD=replace-with-a-unique-runtime-password
LOCAL_CAMPAIGN_OPERATOR_PASSWORD=replace-with-a-unique-operator-password

# Local application container user. Set to the output of `id -u` so the API and
# Next.js server can read the mode-restricted ADC file mounted below.
LOCAL_APP_UID=501

# Host ADC file path. Replace with the absolute path to your gcloud ADC file.
GOOGLE_APPLICATION_CREDENTIALS_HOST=/absolute/path/to/application_default_credentials.json

# Firebase project/web-app configuration. These values are public; keep them
# matched to GOOGLE_CLOUD_PROJECT. The project ID defaults to the repo's current
# local target, marketing-generator-51cc0.
GOOGLE_CLOUD_PROJECT=marketing-generator-51cc0
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDyXF5vI5mLsZWPY-f7AAYzTL3u7ttfp1o
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=marketing-generator-51cc0.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=marketing-generator-51cc0
NEXT_PUBLIC_FIREBASE_APP_ID=1:325794041448:web:ddd677d12febbc0f0a35dd
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=325794041448
