# Runner selection: deterministic or adk
CAMPAIGN_RUNNER_MODE=deterministic

# Backend server
PORT=8080
LOG_LEVEL=info

# Option A: Gemini API key
# GEMINI_API_KEY=replace-me
# GOOGLE_API_KEY=replace-me

# Option B: Vertex AI with Application Default Credentials
GOOGLE_GENAI_USE_VERTEXAI=false
# GOOGLE_CLOUD_PROJECT=replace-me
GOOGLE_CLOUD_LOCATION=us-central1

# Firebase Admin uses Application Default Credentials. GOOGLE_CLOUD_PROJECT is
# also used to validate the audience of Firebase session cookies.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repository/service-account.json

# Database connection required by the API (migrations 001 through 004 plus grants).
# Use the restricted runtime role, not a schema owner or operator login.
# Follow database/README.md before starting the API; startup never migrates schema.
# Local mode requires an explicit PostgreSQL URL; no automatic fallback is used
# by the database lifecycle. Keep real passwords outside version control.
DATABASE_MODE=local
# DATABASE_URL=postgresql://user:password@localhost:5432/campaigns
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10
DATABASE_CONNECT_TIMEOUT=10
DATABASE_COMMAND_TIMEOUT=30
DATABASE_SHUTDOWN_TIMEOUT=10

# Cloud SQL mode: unset DATABASE_URL and use ADC with IAM database authentication.
# DATABASE_MODE=cloud_sql
# DATABASE_INSTANCE=project:region:instance
# DATABASE_NAME=campaigns
# DATABASE_USER=service-account@project.iam

# Operator commands read OPERATOR_DATABASE_* from process environment ONLY.
# They never read this file or fall back to DATABASE_*; see database/OPERATIONS.md.
